{
  "name": "stack-viewer-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen:types": "json2ts --input ../model/src/test/resources/schema-snapshot/model.schema.json --output src/generated/model.ts --no-additionalProperties --unreachableDefinitions",
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p e2e && vite build",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "8.5.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
